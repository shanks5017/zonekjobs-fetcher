# ── zonekjobs-fetcher variables ───────────────────────────────────────────────
# These two MUST match the secret names in GitHub Actions exactly.
# Go to: GitHub repo → Settings → Secrets → Actions → New repository secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-jwt-here
# ↑ Get this from: Supabase Dashboard → Settings → API → service_role (NOT anon key)
