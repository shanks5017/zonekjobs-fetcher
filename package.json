{
  "name": "zonekjobs-fetcher",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "fetch:openjobs": "node --env-file=.env openjobs/run.mjs",
    "fetch:openpostings": "node --env-file=.env openpostings/run.mjs",
    "fetch:jobhive": "node --env-file=.env jobhive-fetcher/run.mjs",
    "fetch:jobhive:greenhouse": "node --env-file=.env jobhive-fetcher/run-full.mjs --ats greenhouse --concurrency 4 --resume",
    "fetch:jobhive:lever": "node --env-file=.env jobhive-fetcher/run-full.mjs --ats lever --concurrency 4 --resume",
    "fetch:jobhive:ashby": "node --env-file=.env jobhive-fetcher/run-full.mjs --ats ashby --concurrency 4 --resume",
    "fetch:jobhive:smartrecruiters": "node --env-file=.env jobhive-fetcher/run-full.mjs --ats smartrecruiters --concurrency 4 --resume",
    "fetch:jobhive:workday": "node --env-file=.env jobhive-fetcher/run-full.mjs --ats workday --concurrency 2 --resume",
    "fetch:jobhive:all": "node --env-file=.env jobhive-fetcher/run-full.mjs --ats all --concurrency 4 --resume",
    "fetch:jobful": "node --env-file=.env jobful-fetcher/run.mjs",
    "fetch:all": "concurrently \"npm run fetch:openjobs\" \"npm run fetch:openpostings\" \"npm run fetch:jobhive\" \"npm run fetch:jobful\"",
    "enrich:companies": "node --env-file=.env company-enricher/run.mjs",
    "enrich:companies:force": "node --env-file=.env company-enricher/run.mjs --force",
    "enrich:companies:dry": "node --env-file=.env company-enricher/run.mjs --dry-run",
    "test:connection": "node --env-file=.env shared/test-connection.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cheerio": "^1.0.0-rc.3",
    "node-fetch": "^3.3.2",
    "playwright": "^1.40.0",
    "request": "^2.88.2",
    "signale": "^1.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
